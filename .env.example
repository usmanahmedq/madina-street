# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
# Set to your PostgreSQL / Neon connection URL. Omit to use local JSON storage.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require"
# Neon hosts automatically use the official driver's secure WebSocket transport
# on TLS port 443, preserving interactive transactions. Other hosts use pg/TCP.
# Optional explicit override: DATABASE_TRANSPORT=postgres or neon-websocket.
